      "parameters": {
        "jsCode": "const services = [\n  { key: \"8188\", url: \"http://127.0.0.1:8188/\" },\n  { key: \"8189\", url: \"http://127.0.0.1:8189/\" },\n  { key: \"11434\", url: \"http://127.0.0.1:11434/\" },\n];\n\nconst output = {};\n\nawait Promise.all(\n  services.map(async ({ key, url }) => {\n    try {\n      await this.helpers.httpRequest({\n        method: \"GET\",\n        url: url,\n        timeout: 3000,\n        ignoreHttpStatusErrors: true,\n      });\n      output[key] = \"running\";\n    } catch (err) {\n      output[key] = \"offline\";\n    }\n  })\n);\n\nreturn [{ json: output }];"
